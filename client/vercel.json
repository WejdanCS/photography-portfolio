{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://photography-portfolio-self-rho.vercel.app/api/:path*"
    },
    { "source": "/login", "destination": "/index.html" }
  ]
}
